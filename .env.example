# ──────────────────────────────────────────────────────────────
# IGFlow — Environment Variables
# کپی کنید به .env.local  →  cp .env.example .env.local
# هیچ‌کدام از این مقادیر نباید در کد hardcode شوند.
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
# آدرس عمومی اپ (باید HTTPS و در دسترس Meta باشد؛ در لوکال از ngrok/cloudflared استفاده کنید)
APP_URL=http://localhost:3000
PORT=3000

# ── Auth (SaaS خودمان) ────────────────────────────────────────
# حداقل ۳۲ کاراکتر. تولید:  openssl rand -base64 48
AUTH_JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
AUTH_SESSION_TTL_HOURS=168
# اگر داشبورد داخل iframe از دامنهٔ دیگری سرو می‌شود (محیط پیش‌نمایش/امبد)، این را true کنید
# تا کوکی سشن با SameSite=None; Secure ست شود. در استقرار معمولی false بماند.
AUTH_COOKIE_CROSS_SITE=false

# ── رمزنگاری توکن‌های اینستاگرام (AES-256-GCM) ────────────────
# دقیقاً ۳۲ بایت، base64. تولید:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-32-byte-base64-key-aaaaaaaaaaaaaaaa=

# ── Instagram / Meta App ──────────────────────────────────────
# App Dashboard > Instagram > API setup with Instagram business login
IG_APP_ID=
IG_APP_SECRET=
# باید دقیقاً با یکی از OAuth redirect URI های ثبت‌شده در داشبورد یکی باشد
IG_REDIRECT_URI=http://localhost:3000/api/instagram/callback
IG_GRAPH_VERSION=v25.0
IG_GRAPH_HOST=https://graph.instagram.com
IG_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
IG_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
IG_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# فیلدهای webhook که هنگام اتصال حساب subscribe می‌شوند
IG_WEBHOOK_FIELDS=comments,messages,messaging_postbacks,messaging_optins

# ── Zernio (provider واسط اختیاری) ───────────────────────────────────
# کلید را از Dashboard > API Keys بسازید؛ فقط در secret manager نگه دارید.
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# رشتهٔ تصادفی حداقل 32 کاراکتری؛ همین مقدار را هنگام ساخت Webhook در Zernio وارد کنید.
ZERNIO_WEBHOOK_SECRET=
# Callback: https://YOUR-DOMAIN/api/webhooks/zernio

# ── Webhook ───────────────────────────────────────────────────
# همان رشته‌ای که در App Dashboard > Webhooks > Verify Token وارد می‌کنید
IG_WEBHOOK_VERIFY_TOKEN=replace-me-webhook-verify-token
# امضای X-Hub-Signature-256 با App Secret محاسبه می‌شود.
# فقط برای تست لوکال می‌توان موقتاً false کرد — در production حتماً true
WEBHOOK_SIGNATURE_REQUIRED=true

# ── Database ──────────────────────────────────────────────────
# Postgres واقعی:
# DATABASE_URL=postgres://igflow:igflow@localhost:5432/igflow
# اگر خالی باشد از PGlite (Postgres روی WASM، فایل محلی) استفاده می‌شود — فقط dev/test
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ── Queue ─────────────────────────────────────────────────────
# اگر خالی باشد صف in-memory استفاده می‌شود — فقط dev/test
REDIS_URL=
QUEUE_PREFIX=igflow
QUEUE_CONCURRENCY=5
# روی Vercel/سرورلس برای محافظت از مسیر نگهداری الزامی است
CRON_SECRET=replace-me-with-a-long-random-cron-secret
# خالی = تشخیص خودکار؛ true برای Vercel، false وقتی Worker جدا دارید
INLINE_WEBHOOK_PROCESSING=

# ── Rate limiting (مطابق محدودیت‌های رسمی Instagram) ───────────
RL_MESSAGES_PER_MINUTE=60
RL_PRIVATE_REPLIES_PER_HOUR=700
RL_BURST=10

# ── Retry ─────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MS=5000,30000,120000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
